# Supabase — get these from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Company header used on the exported Job Card Excel
COMPANY_NAME="SBJ Technical Works LLC"
COMPANY_ADDRESS="Dubai Industrial City"

# Coming later — leave blank for now
GAMMA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Railway provides PORT automatically — do NOT set it locally
# Next.js binds to $PORT in production; defaults to 3000 for local dev
